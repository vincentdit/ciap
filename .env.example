# Copy this file to .env and fill in real values.
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=ciap
MYSQL_USER=ciap
MYSQL_PASSWORD=change_me
# Generate with: openssl rand -base64 48  (or PowerShell RandomNumberGenerator)
# The docker profile refuses the development fallback and any secret shorter than 32 bytes.
CIAP_JWT_SECRET=change_me_to_a_48_byte_base64_secret
CIAP_ADMIN_EMAIL=admin@tirdo.go.tz
# Used only when the database has no users. The docker profile refuses the built-in development password.
CIAP_ADMIN_PASSWORD=change_me
# Comma-separated browser origins. Do not use *.
CIAP_CORS_ORIGINS=http://localhost:4200,http://localhost:8088
