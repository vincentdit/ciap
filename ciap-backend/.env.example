# Copy to .env and adjust. NEVER commit real secrets.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ciap
DB_USER=ciap_app
DB_PASSWORD=change_me
SERVER_PORT=8080
# Base64-encoded 256-bit key. Generate with: openssl rand -base64 32
CIAP_JWT_SECRET=change_me_to_a_unique_base64_secret
CIAP_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
CIAP_BOOTSTRAP_ADMIN_PASSWORD=change_me_before_first_boot
